# Copy to .env (ignored by Git). Never commit real private keys.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BETTER_AUTH_SECRET=replace-with-a-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DDS_CLIENT_ID=
GOOGLE_DDS_CLIENT_SECRET=
GEMINI_API_KEY=
APP_SETTINGS_ENCRYPTION_KEY=

# Local OCR for scanned PDFs (see docs/ARCHITECTURE.md "Local OCR runtime").
# OCR_BUNDLE_RUNTIME=true downloads the runtime at build; OCR_ENABLED=true uses it.
OCR_BUNDLE_RUNTIME=
OCR_ENABLED=
# Decoded-byte ceiling for sending a PDF to Gemini visually (default 20 MB).
GEMINI_INLINE_MAX_BYTES=

# Company / agency logo storage. These are server environment variables.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/g34rc6almj
IMAGEKIT_PUBLIC_KEY=public_gQjdhoTUwYzTzLu34sUqKKp4glY=
IMAGEKIT_PRIVATE_KEY=replace-with-your-imagekit-private-key
